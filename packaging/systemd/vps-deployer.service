[Unit]
Description=VPS Deployer
After=network.target

[Service]
Type=simple
User=vps-deployer
Group=vps-deployer
WorkingDirectory=/opt/vps-deployer/app
EnvironmentFile=/etc/vps-deployer/config.env
ExecStart=/opt/vps-deployer/app/.venv/bin/uvicorn vps_deployer.api.main:app --host 127.0.0.1 --port 5100
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
