read_nginx_stdin() {
  local project="$1"
  local content
  content="$(cat)"
  validate_nginx_site "$project" "$content"
  printf '%s' "$content"
}

validate_external_path() {
  local project="$1" path="$2" filename
  filename="${path##*/}"
  [[ "${path%/*}" == "/etc/ssl/vps-deployer/${project}" ]] || reject "invalid external certificate directory"
  [[ "$filename" =~ ^[a-zA-Z0-9_-]+\.(pem|crt|key)$ ]] || reject "invalid external certificate filename"
}

check_external_certificate() {
  local project="$1" cert="$2" key="$3" path host parent cert_public key_public
  shift 3
  [[ $# -gt 0 && $# -le 20 ]] || reject "provide 1-20 certificate hostnames"
  for path in "$cert" "$key"; do
    validate_external_path "$project" "$path"
    [[ -f "$path" && "$(readlink -f -- "$path")" == "$path" ]] || reject "certificate must be a regular file without symlinks"
    [[ "$(stat -c %u "$path")" == 0 ]] || reject "external certificate files must be owned by root"
    [[ -z "$(find "$path" -maxdepth 0 -perm /022 -print)" ]] || reject "external certificate files must not be group/world writable"
    parent="${path%/*}"
    while [[ "$parent" != / ]]; do
      [[ "$(stat -c %u "$parent")" == 0 ]] || reject "certificate directories must be owned by root"
      [[ -z "$(find "$parent" -maxdepth 0 -perm /022 -print)" ]] || reject "certificate directories must not be group/world writable"
      parent="${parent%/*}"
      [[ -n "$parent" ]] || parent=/
    done
  done
  [[ -z "$(find "$key" -maxdepth 0 -perm /077 -print)" ]] || reject "private key must have mode 600 or 400"
  openssl x509 -in "$cert" -noout -checkend 0 >/dev/null 2>&1 || reject "invalid or expired certificate"
  openssl verify -no-CAfile -no-CApath -partial_chain -trusted "$cert" "$cert" >/dev/null 2>&1 || reject "certificate is not currently valid"
  cert_public="$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null)" || reject "invalid certificate"
  key_public="$(openssl pkey -in "$key" -passin pass: -pubout 2>/dev/null)" || reject "invalid or encrypted private key"
  [[ "$cert_public" == "$key_public" ]] || reject "certificate and key do not match"
  for host in "$@"; do
    validate_nginx_hostname "$host"
    openssl verify -no-CAfile -no-CApath -partial_chain -trusted "$cert" -verify_hostname "$host" "$cert" >/dev/null 2>&1 || reject "certificate does not cover $host"
  done
}

# Serialize Nginx mutations and restore files/symlinks when test or reload fails.
install_project_site_transaction() {
  local project="$1" content="$2" site backup directory target
  site="$(nginx_site_name "$project")"
  exec 9>/run/lock/vps-deployer-nginx.lock
  flock -x 9
  backup="$(mktemp -d)"
  for directory in sites-available sites-enabled conf.d; do
    target="/etc/nginx/${directory}/${site}"
    if [[ -e "$target" || -L "$target" ]]; then
      cp -a -- "$target" "${backup}/${directory}"
    fi
  done
  if install_named_nginx_site "$site" "$content" && nginx -t && reload_nginx; then
    rm -rf -- "$backup"
    return 0
  fi
  remove_nginx_site_files "$project"
  for directory in sites-available sites-enabled conf.d; do
    if [[ -e "${backup}/${directory}" || -L "${backup}/${directory}" ]]; then
      cp -a -- "${backup}/${directory}" "/etc/nginx/${directory}/${site}"
    fi
  done
  rm -rf -- "$backup"
  reload_nginx || true
  echo "nginx test/reload failed; previous site restored" >&2
  return 3
}

read_dashboard_nginx_stdin() {
  local content
  content="$(cat)"
  validate_dashboard_nginx_site "$content"
  printf '%s' "$content"
}

reload_nginx() {
  require_nginx
  nginx -t
  if command -v systemctl >/dev/null 2>&1; then
    systemctl reload nginx 2>/dev/null || nginx -s reload
  else
    nginx -s reload
  fi
}

remove_named_nginx_site() {
  local site="$1"
  rm -f -- "/etc/nginx/sites-enabled/${site}"
  rm -f -- "/etc/nginx/sites-available/${site}"
  rm -f -- "/etc/nginx/conf.d/${site}"
}

remove_nginx_site_files() {
  local project="$1"
  remove_named_nginx_site "$(nginx_site_name "$project")"
}

remove_dashboard_site_files() {
  remove_named_nginx_site "$DASHBOARD_SITE"
}

install_named_nginx_site() {
  local site="$1"
  local content="$2"
  local tmp
  tmp="$(mktemp)"
  printf '%s\n' "$content" >"$tmp"
  if [[ -d /etc/nginx/sites-available ]]; then
    install -m 0644 "$tmp" "/etc/nginx/sites-available/${site}" || { rm -f "$tmp"; return 3; }
    if [[ -d /etc/nginx/sites-enabled ]]; then
      ln -sfn "/etc/nginx/sites-available/${site}" "/etc/nginx/sites-enabled/${site}" || { rm -f "$tmp"; return 3; }
    fi
  elif [[ -d /etc/nginx/conf.d ]]; then
    install -m 0644 "$tmp" "/etc/nginx/conf.d/${site}" || { rm -f "$tmp"; return 3; }
  else
    rm -f "$tmp"
    reject "nginx configuration directory is missing"
  fi
  rm -f "$tmp"
}

action="${1:-}"
if [[ -z "$action" ]]; then
  usage
  exit 1
fi

case "$action" in
  host-nginx-inventory | host-nginx-read | host-nginx-action | host-service-inventory | host-service-action | host-ssl-import | host-handover | host-handover-rollback | host-nginx-certificate)
    [[ $# -eq 1 ]] || reject "unexpected host action arguments"
    exec /usr/bin/python3 -I /usr/local/libexec/vps-deployer-admin.py "$action"
    ;;
  service-status)
    unit="${2:-}"
    validate_platform_unit "$unit"
    require_systemctl
    systemctl is-active -- "$unit" || true
    systemctl status --no-pager -- "$unit" || true
    ;;
  nginx-test)
    require_nginx
    nginx -t
    ;;
  nginx-reload)
    reload_nginx
    ;;
  nginx-site-check)
    project="${2:-}"
    validate_project_name "$project"
    read_nginx_stdin "$project" >/dev/null
    echo "ok"
    ;;
  nginx-site-read)
    project="${2:-}"
    validate_project_name "$project"
    site="$(nginx_site_name "$project")"
    if [[ -d /etc/nginx/sites-available ]]; then
      path="/etc/nginx/sites-available/${site}"
    else
      path="/etc/nginx/conf.d/${site}"
    fi
    printf '%s\n' "$path"
    [[ ! -L "$path" ]] || reject "site file must not be a symlink"
    if [[ -f "$path" ]]; then cat -- "$path"; fi
    ;;
  ssl-external-check)
    project="${2:-}"
    validate_project_name "$project"
    shift 2
    [[ $# -ge 3 ]] || reject "missing certificate, key or hostnames"
    check_external_certificate "$project" "$@"
    echo "ok"
    ;;
  nginx-site-install)
    project="${2:-}"
    validate_project_name "$project"
    require_nginx
    content="$(read_nginx_stdin "$project")"
    install_project_site_transaction "$project" "$content"
    ;;
  dashboard-site-check)
    read_dashboard_nginx_stdin >/dev/null
    echo "ok"
    ;;
  dashboard-site-install)
    require_nginx
    content="$(read_dashboard_nginx_stdin)"
    install_named_nginx_site "$DASHBOARD_SITE" "$content"
    if ! nginx -t >/dev/null 2>&1; then
      remove_dashboard_site_files
      echo "nginx configuration test failed" >&2
      exit 3
    fi
    reload_nginx
    ;;
  dashboard-site-remove)
    require_nginx
    remove_dashboard_site_files
    reload_nginx
    ;;
  nginx-site-remove)
    project="${2:-}"
    validate_project_name "$project"
    require_nginx
    remove_nginx_site_files "$project"
    reload_nginx
    ;;
  ssl-issue)
    email="${2:-}"
    cert_name="${3:-}"
    shift 3 || reject "missing certificate hostnames"
    validate_email "$email"
    validate_nginx_hostname "$cert_name"
    if [[ $# -lt 1 ]]; then
      reject "missing certificate hostnames"
    fi
    if [[ $# -gt 20 ]]; then
      reject "too many hostnames"
    fi
    matched=0
    for host in "$@"; do
      validate_nginx_hostname "$host"
      if [[ "$host" == "$cert_name" ]]; then
        matched=1
      fi
    done
    if [[ "$matched" -ne 1 ]]; then
      reject "certificate name must be one of the hostnames"
    fi
    require_certbot
    mkdir -p /var/www/certbot
    cert_args=(
      certbot certonly --webroot -w /var/www/certbot
      --non-interactive --agree-tos --keep-until-expiring
      --cert-name "$cert_name" --email "$email"
    )
    for host in "$@"; do
      cert_args+=(-d "$host")
    done
    "${cert_args[@]}"
    ;;
  ssl-renew)
    require_certbot
    certbot renew --non-interactive --quiet
    if command -v nginx >/dev/null 2>&1; then
      reload_nginx
    fi
    ;;
  app-start | app-stop | app-restart | app-status | app-enable | app-disable | app-logs | app-unit-remove)
    project="${2:-}"
    validate_project_name "$project"
    unit="$(app_unit "$project")"
    require_systemctl
    case "$action" in
      app-start)
        systemctl start -- "$unit"
        ;;
      app-stop)
        systemctl stop -- "$unit" || true
        ;;
      app-restart)
        systemctl restart -- "$unit"
        ;;
      app-status)
        systemctl is-active -- "$unit" || true
        ;;
      app-enable)
        systemctl enable -- "$unit"
        ;;
      app-disable)
        systemctl disable -- "$unit" || true
        ;;
      app-logs)
        if ! command -v journalctl >/dev/null 2>&1; then
          echo "journalctl is not available" >&2
          exit 4
        fi
        journalctl --no-pager -n 200 -u "$unit"
        ;;
      app-unit-remove)
        systemctl stop -- "$unit" || true
        systemctl disable -- "$unit" || true
        rm -f -- "/etc/systemd/system/${unit}"
        systemctl daemon-reload
        ;;
    esac
    ;;
  app-unit-check)
    project="${2:-}"
    validate_project_name "$project"
    read_unit_stdin "$project" >/dev/null
    echo "ok"
    ;;
  app-unit-install)
    project="${2:-}"
    validate_project_name "$project"
    require_systemctl
    unit="$(app_unit "$project")"
    content="$(read_unit_stdin "$project")"
    tmp="$(mktemp)"
    printf '%s\n' "$content" >"$tmp"
    install -m 0644 "$tmp" "/etc/systemd/system/${unit}"
    rm -f "$tmp"
    systemctl daemon-reload
    systemctl enable -- "$unit"
    ;;
  *)
    reject "unknown action"
    ;;
esac
